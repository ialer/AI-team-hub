# Copy to .env and fill in.

# REQUIRED. Every agent token is derived from this value.
# Rotating it rotates every agent token — agents must re-read theirs.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HUB_ADMIN_TOKEN=change-me-please

# Optional overrides
# HUB_PORT=8899
# HUB_HOST=0.0.0.0
# HUB_DATA_DIR=./data
# HUB_DEFAULT_ROOM=team
# HUB_CONTEXT_WINDOW=10
# HUB_WAKE_TIMEOUT=180