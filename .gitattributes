# Shell scripts and Docker files must keep LF even on Windows checkouts,
# otherwise `./script.sh` breaks with a bad interpreter error.
*.sh            text eol=lf
*.py            text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.mjs           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.html          text eol=lf
*.css           text eol=lf